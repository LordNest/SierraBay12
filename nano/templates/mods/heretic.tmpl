<style>
	:root {
		--heretic-red: #e03c3c;
		--heretic-blue: #2185d0;
		--heretic-purple: #bd54e0;
		--heretic-green: #20b142;
		--heretic-yellow: yellow;
	}
	body {
		background: #1a1a1a;
		color: #e0e0e0;
		font-family: Verdana, sans-serif;
		font-size: 12px;
		margin: 0;
		padding: 0;
	}
	.Window {
		border: 1px solid #444;
		background: #222;
		box-shadow: 0 0 10px rgba(0,0,0,0.5);
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.Window-Content {
		padding: 8px;
		flex: 1;
		overflow-y: auto;
	}
	.Stack { display: flex; }
	.Stack-vertical { flex-direction: column; }
	.Stack-Item { margin: 4px 0; }
	.Stack-Item.grow { flex-grow: 1; }
	.Section {
		border: 1px solid #444;
		padding: 10px;
		margin-bottom: 10px;
		background: #2a2a2a;
		border-radius: 4px;
	}
	.Section-title {
		font-weight: bold;
		margin-bottom: 8px;
		border-bottom: 1px solid #444;
		padding-bottom: 4px;
		font-size: 14px;
	}
	.Tabs { display: flex; border-bottom: 1px solid #555; margin-bottom: 10px; }
	.Tabs.fluid { width: 100%; }
	.Tabs.vertical { flex-direction: column; border-bottom: none; border-right: 1px solid #555; width: 150px; }
	.Tabs-Tab {
		padding: 8px 16px;
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}
	.Tabs-Tab.selected {
		border-bottom: 2px solid var(--heretic-purple);
		font-weight: bold;
		color: #fff;
	}
	.Tabs.vertical .Tabs-Tab.selected {
		border-bottom: none;
		border-right: 2px solid var(--heretic-purple);
	}
	.KnowledgeNode {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin: 8px;
		background: #111;
		border: 2px solid #555;
		cursor: pointer;
	}
	.KnowledgeNode.ascension { width: 192px; height: 192px; }
	.KnowledgeNode.done { border-color: var(--heretic-green); }
	.KnowledgeNode.disabled { opacity: 0.4; cursor: not-allowed; }
	.KnowledgeNode-cost {
		position: absolute;
		top: 2px;
		left: 2px;
		background: black;
		color: white;
		font-weight: bold;
		border-radius: 100%;
		padding: 2px 5px;
		font-size: 10px;
	}
	.heretic-red { color: var(--heretic-red); }
	.heretic-blue { font-weight: bold; color: var(--heretic-blue); }
	.heretic-purple { font-weight: bold; color: var(--heretic-purple); }
	.heretic-green { font-weight: bold; color: var(--heretic-green); }
	.heretic-yellow { font-weight: bold; color: var(--heretic-yellow); }
	.small { font-size: 10px; color: #aaa; }
	.panel { display: none; }
	.panel.active { display: block; }
</style>

<div class="Window">
	<div class="Window-Content">
		<div class="Tabs">
			<div class="Tabs-Tab selected" data-tab="info" onclick="showTab('info')">Information</div>
			<div class="Tabs-Tab" data-tab="paths" onclick="showTab('paths')">Path Info</div>
			<div class="Tabs-Tab" data-tab="research" onclick="showTab('research')">Research</div>
		</div>

		<div id="info" class="panel active">
			<div class="Section">
				You have <b class="heretic-blue">{{:data.charges}}</b> knowledge point{{if data.charges != 1}}s{{/if}}.
			</div>
			<div class="Section">
				You have made <b class="heretic-red">{{:data.total_sacrifices}}</b> sacrifices.
			</div>
			<div class="Section">
				Ascended: <b>{{if data.ascended}}Yes{{else}}No{{/if}}</b>
			</div>
			<div class="Section">
				<div class="Section-title">Objectives</div>
				{{for data.objectives :objective}}
					<div>{{:objective.explanation}}</div>
				{{/for}}
			</div>
		</div>

		<div id="paths" class="panel">
			<div class="Section">
				<div style="display: flex; flex-wrap: wrap; gap: 8px;">
					{{for data.paths :path}}
						<div class="KnowledgeNode" onclick="window.location='byond://?src=\ref[src];research=1;path={{:path.starting_knowledge.path}};category=start'" title="{{:path.description[0]}}">
							<img src="{{:path.icon.icon}}" style="width:40px;height:40px;" />
							<div class="KnowledgeNode-cost">{{:path.starting_knowledge.cost}}</div>
						</div>
					{{/for}}
				</div>
			</div>
			<div class="Section">
				<div class="Section-title">Path selection</div>
				<div class="small">Choose a starting node to begin your path.</div>
			</div>
		</div>

		<div id="research" class="panel">
			<div class="Section">
				<span class="heretic-yellow">Research</span> — available points: <b>{{:data.charges}}</b>
			</div>
			{{for data.knowledge_tiers :tier}}
				<div class="Section">
					{{for tier.nodes :node}}
						<div class="KnowledgeNode {{if node.done}}done{{/if}} {{if node.disabled}}disabled{{/if}}"
							onclick="{{if !node.disabled}}window.location='byond://?src=\ref[src];research=1;path={{:node.path}};category={{:node.category}}'{{/if}}"
							title="{{:node.desc}}">
							<img src="{{:node.icon_params.icon}}" style="width:40px;height:40px;" />
							<div class="KnowledgeNode-cost">{{:node.cost}}</div>
						</div>
					{{/for}}
				</div>
			{{/for}}
			{{if data.knowledge_shop.length}}
			<div class="Section">
				<div class="Section-title">Knowledge shop</div>
				{{for data.knowledge_shop :node}}
					<div class="KnowledgeNode {{if node.done}}done{{/if}} {{if node.disabled}}disabled{{/if}}"
						onclick="{{if !node.disabled}}window.location='byond://?src=\ref[src];research=1;path={{:node.path}};category={{:node.category}}'{{/if}}"
						title="{{:node.desc}}">
						<img src="{{:node.icon_params.icon}}" style="width:40px;height:40px;" />
						<div class="KnowledgeNode-cost">{{:node.cost}}</div>
					</div>
				{{/for}}
			</div>
			{{/if}}
		</div>
	</div>
</div>

<script>
	function showTab(name) {
		var tabs = document.querySelectorAll('.Tabs-Tab');
		for (var i = 0; i < tabs.length; i++) {
			tabs[i].classList.remove('selected');
		}
		var panels = document.querySelectorAll('.panel');
		for (var i = 0; i < panels.length; i++) {
			panels[i].classList.remove('active');
		}
		var selectedTab = document.querySelector('.Tabs-Tab[data-tab="' + name + '"]');
		if (selectedTab) {
			selectedTab.classList.add('selected');
		}
		var selectedPanel = document.getElementById(name);
		if (selectedPanel) {
			selectedPanel.classList.add('active');
		}
	}
</script>
